parameters:
    level: 4
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    ignoreErrors:
        -
            identifier: property.defaultValue
            path: src/Widgets/AdjacencyListWidget.php
            reportUnmatched: false
        # Methods of staudenmeir's HasRecursiveRelationships trait, which a type cannot name.
        -
            message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model::(getParentKeyName|getDepthName|descendants)\(\)\.$#'
            path: src/Forms/Components/Concerns/HasRelationship.php
